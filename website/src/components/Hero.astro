---
const githubUrl = "https://github.com/jimmymills/patchfeld";
---

<section id="top" class="relative pt-20 pb-24 sm:pt-28 sm:pb-32">
  <div class="container-page">
    <div class="max-w-3xl">
      <div class="fade-in" style="animation-delay: 0ms">
        <span
          class="mono inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg-card)] px-3 py-1 text-xs text-[color:var(--color-fg-muted)]"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent)] animate-pulse"></span>
          v0.2.0 — permission modals shipped
        </span>
      </div>

      <h1
        class="wordmark fade-in mt-6 text-5xl leading-[0.95] sm:text-7xl"
        style="animation-delay: 60ms"
      >
        <span class="bg-gradient-to-br from-white via-white to-[color:var(--color-accent-soft)] bg-clip-text text-transparent">
          patchfeld
        </span>
      </h1>

      <p
        class="fade-in mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-fg-muted)] sm:text-xl"
        style="animation-delay: 140ms"
      >
        A Textual TUI that turns
        <span class="text-[color:var(--color-fg)]">N parallel Claude Code sessions</span>
        into one orchestrator-managed workspace —
        and lets the agent reshape the UI to fit the work.
      </p>

      <div class="fade-in mt-10 flex flex-col gap-3 sm:flex-row sm:items-center" style="animation-delay: 220ms">
        <div
          id="install-copy"
          class="group relative flex items-center gap-3 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg-card)] px-4 py-3 hover:border-[var(--color-accent-dim)] transition-colors cursor-pointer"
          data-copy="pip install patchfeld"
        >
          <span class="mono text-[color:var(--color-accent)]">$</span>
          <code class="mono text-[color:var(--color-fg)] text-sm sm:text-base">
            pip install patchfeld
          </code>
          <span class="ml-2 inline-flex h-6 w-6 items-center justify-center text-[color:var(--color-fg-muted)] group-hover:text-[color:var(--color-fg)]">
            <svg
              data-icon="copy"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="4" y="4" width="8" height="9" rx="1" />
              <path d="M3 11V3a1 1 0 0 1 1-1h7" />
            </svg>
            <svg
              data-icon="check"
              class="hidden"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M3 8.5l3 3 7-7" />
            </svg>
          </span>
          <span
            id="install-copy-toast"
            class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 rounded bg-[var(--color-bg-elev)] px-2 py-1 text-xs text-[color:var(--color-fg)] opacity-0 transition-opacity"
          >
            copied
          </span>
        </div>

        <a
          href={githubUrl}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-3 text-sm font-medium text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] hover:border-[var(--color-border-strong)] transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span>View on GitHub</span>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 3h7v7M13 3l-9 9" />
          </svg>
        </a>
      </div>

      <p class="fade-in mt-6 text-sm text-[color:var(--color-fg-dim)]" style="animation-delay: 300ms">
        Python 3.11+ · MIT · a studio for orchestrating agents
      </p>
    </div>
  </div>

  <script>
    const root = document.getElementById("install-copy");
    if (root) {
      const toast = document.getElementById("install-copy-toast");
      const iconCopy = root.querySelector('[data-icon="copy"]') as HTMLElement | null;
      const iconCheck = root.querySelector('[data-icon="check"]') as HTMLElement | null;
      const text = root.dataset.copy ?? "";
      let timer: ReturnType<typeof setTimeout> | null = null;
      root.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // fallback: do nothing — user can still triple-click select the visible text
          return;
        }
        if (toast) {
          toast.style.opacity = "1";
        }
        iconCopy?.classList.add("hidden");
        iconCheck?.classList.remove("hidden");
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          if (toast) toast.style.opacity = "0";
          iconCopy?.classList.remove("hidden");
          iconCheck?.classList.add("hidden");
        }, 1600);
      });
    }
  </script>
</section>
