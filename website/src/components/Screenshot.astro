---
import { Image } from "astro:assets";
import screenshot from "../assets/screenshot.png";
---

<section id="screenshot" class="py-16 sm:py-24">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mono text-sm text-[color:var(--color-accent)]">/* what it looks like */</p>
      <h2 class="mt-3 text-3xl sm:text-4xl">Patchfeld, running.</h2>
      <p class="mt-4 text-[color:var(--color-fg-muted)]">
        Orchestrator chat on the left. Agent table and cross-agent activity feed on the right.
        StatusBar tracks tokens, cost, and active children across every session.
      </p>
    </div>

    <div class="reveal mt-12">
      <div
        class="relative overflow-hidden rounded-xl border border-[var(--color-border-strong)] bg-[var(--color-bg-card)] shadow-2xl shadow-black/40"
      >
        {/* faux window chrome — feels like a real screenshot frame */}
        <div class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-bg-soft)] px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
          <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
          <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
          <span class="mono ml-3 text-xs text-[color:var(--color-fg-dim)]">
            patchfeld — ~/Developer/patchfeld
          </span>
        </div>
        <Image
          src={screenshot}
          alt="patchfeld TUI: orchestrator chat on the left, agent table and activity feed on the right"
          loading="lazy"
          class="block w-full h-auto"
        />
      </div>
    </div>
  </div>
</section>
